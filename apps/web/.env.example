# Copie para .env.local e preencha. Campos vazios usam o valor padrão indicado.

# Endereço público do site, sem barra no final (usado em links canônicos, sitemap e Open Graph).
# Padrão: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# E-mail de contato exibido no site e nos textos legais. Padrão: contato@graoraiz.com.br
NEXT_PUBLIC_CONTATO_EMAIL=

# Links das lojas. Enquanto vazios, o site mostra "Em breve no Android e no iPhone".
NEXT_PUBLIC_PLAY_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Nome ou razão social (e, se quiser, CNPJ/CPF) do responsável pelos dados.
# Enquanto vazio, Privacidade e Termos mostram um placeholder e o aviso de revisão.
NEXT_PUBLIC_RESPONSAVEL=

# Chave comercial do Open-Meteo (opcional). Com ela, as rotas /api/previsao e /api/historico
# usam o servidor customer-*.open-meteo.com. Uso comercial exige plano pago no Open-Meteo.
OPEN_METEO_API_KEY=

# Supabase para a lista de espera (só no servidor; nunca exponha a service_role no navegador).
# Crie a tabela com supabase/lista_espera.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

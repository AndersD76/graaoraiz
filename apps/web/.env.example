# Copie para .env.local e preencha. Campos vazios usam o valor padrão indicado.

# Endereço público do site, sem barra no final (usado em links canônicos, sitemap e Open Graph).
# Padrão: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# WhatsApp de contato exibido no site e nos textos legais (só dígitos, com 55 e DDD). Padrão: 5554999648368
NEXT_PUBLIC_CONTATO_WHATSAPP=

# Links das lojas. Enquanto vazios, o site mostra "Em breve no Android e no iPhone".
NEXT_PUBLIC_PLAY_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Nome ou razão social (e, se quiser, CNPJ/CPF) do responsável pelos dados.
# Enquanto vazio, Privacidade e Termos mostram um placeholder e o aviso de revisão.
NEXT_PUBLIC_RESPONSAVEL=

# Chave comercial do Open-Meteo (opcional). Com ela, as rotas /api/previsao e /api/historico
# usam o servidor customer-*.open-meteo.com. Uso comercial exige plano pago no Open-Meteo.
OPEN_METEO_API_KEY=

# Contas do app (cadastro, login e dados na nuvem). Tabelas em db/contas.sql (node db/aplicar.mjs).
DATABASE_URL=
# Segredo dos tokens de sessão, com 32 caracteres ou mais. Obrigatório em produção.
AUTH_SECRET=

# E-mail do "esqueci a senha" pela Resend (resend.com). Sem a chave, em produção a recuperação
# responde que está indisponível; em desenvolvimento o código sai no console do servidor.
RESEND_API_KEY=
# Remetente com domínio verificado na Resend, ex.: Grão Raiz <nao-responda@graoraiz.com.br>
EMAIL_REMETENTE=

# Supabase para a lista de espera (só no servidor; nunca exponha a service_role no navegador).
# Crie a tabela com supabase/lista_espera.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Classificados de máquinas: comissão sobre a venda, em %. Vazio (padrão) = grátis, sem comissão
# (decisão de 18/11/2026). Ex.: 3 volta a cobrar, só para anúncios novos.
COMISSAO_PERCENTUAL=
# Chave dos painéis internos (/painel/maquinas e /avaliacoes). Sem ela, usa AVALIACOES_CHAVE.
PAINEL_CHAVE=

# Crescimento orgânico (lib/seo). Os nomes abaixo são os que o site lê.
# GA4 (G-XXXX). É NEXT_PUBLIC: só entra no próximo build. Carrega com Consent Mode v2 negado por padrão.
NEXT_PUBLIC_GA4_ID=
# Search Console: conta de serviço proprietária da propriedade (lib/seo/buscadores.ts).
# A chave privada vai com \n no lugar das quebras de linha.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
# Padrão: sc-domain:<domínio sem www>.
GSC_PROPRIEDADE=
# Bing Webmaster (uma chave por usuário, vale para todos os sites).
BING_WEBMASTER_API_KEY=
INDEXNOW_KEY=
# Rotina de hora em hora (instrumentation.ts -> /api/cron/seo). ROTINA_SEO=desligada desliga.
CRON_SECRET=
ROTINA_SEO=
# Gravados por outra sessão no Railway e ainda não lidos pelo site (reservados para leitura do GA4 Data API).
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GA4_PROPERTY_ID=
GA4_MEASUREMENT_ID=
GSC_SITE_URL=

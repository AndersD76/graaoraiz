{
  "expo": {
    "name": "Grão Raiz",
    "slug": "grao-raiz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "graoraiz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.graoraiz.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "NSLocationTemporaryUsageDescriptionDictionary": {
          "ExpoLocationFullAccuracy": "A localização precisa ajuda a marcar o talhão no lugar certo."
        }
      }
    },
    "android": {
      "package": "com.graoraiz.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F6B2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6B2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "locationWhenInUsePermission": "O Grão Raiz usa sua localização só quando você pede, para marcar o talhão e buscar a previsão do lugar certo.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F6B2E",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Grão Raiz usa suas fotos só quando você escolhe uma imagem para registrar uma ocorrência na lavoura.",
          "cameraPermission": "O Grão Raiz usa a câmera só quando você tira foto de uma ocorrência na lavoura (granizo, geada, praga) para guardar como prova.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d6095498-2516-43ab-8117-7f89109d5b9c"
      }
    },
    "owner": "andersd1976"
  }
}

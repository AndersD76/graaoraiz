{
  "expo": {
    "name": "Grão Raiz",
    "slug": "grao-raiz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "graoraiz",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.graoraiz.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR"
      }
    },
    "android": {
      "package": "com.graoraiz.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1F6B2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6B2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "locationWhenInUsePermission": "O Grão Raiz usa sua localização só quando você pede, para marcar o talhão e buscar a previsão do lugar certo."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F6B2E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

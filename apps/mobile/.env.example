# Copie para .env (não vai para o Git). Em builds na nuvem, cadastre as mesmas variáveis no EAS
# (expo.dev → projeto → Environment variables) para os ambientes development, preview e production.

# Servidor próprio (apps/web) que repassa a previsão com cache e esconde a chave comercial do Open-Meteo.
# Sem ele o app consulta o Open-Meteo direto (bom para testar; uso comercial exige a chave no servidor).
EXPO_PUBLIC_API_URL=

# Servidor das contas (apps/web publicado): cadastro, login e dados na nuvem. Vazio = usa EXPO_PUBLIC_API_URL;
# se os dois estiverem vazios, o app não pede login e guarda tudo só no aparelho.
EXPO_PUBLIC_SERVIDOR_URL=

# Site com política de privacidade, termos e página /baixar.
EXPO_PUBLIC_SITE_URL=https://graoraiz.com.br

# Chaves públicas do RevenueCat (Project settings → API keys). Sem elas a assinatura fica desligada.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# 1 = versão de demonstração, com todos os módulos do Pro liberados sem assinatura.
# Já vem ligada no perfil preview do eas.json; nunca cadastre no ambiente production.
EXPO_PUBLIC_LIBERAR_PRO=

# Lida no app.config.ts durante a build (opcional: o projectId já fica no app.json).
EAS_PROJECT_ID=

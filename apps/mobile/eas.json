{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_LIBERAR_PRO": "1",
        "EXPO_PUBLIC_SERVIDOR_URL": "https://graaoraiz-production.up.railway.app",
        "EXPO_PUBLIC_SITE_URL": "https://graaoraiz-production.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleId": "daniel.anders@brturbo.com.br",
        "appleTeamId": "53JA8M2JRZ"
      }
    }
  }
}
